rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Chặn hoàn toàn quyền đọc/ghi trực tiếp từ trình duyệt khách.
    // Mọi thao tác đều phải đi qua server API bằng Firebase Admin SDK.
    match /rsvps/{document=**} {
      allow read, write: if false;
    }
  }
}
