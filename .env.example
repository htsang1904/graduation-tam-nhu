# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN THIỆP MỜI
# Copy file này thành .env.local để sử dụng khi chạy dev
# ==========================================

# 1. Cấu hình Firebase Client (Dành cho trang đăng nhập Admin Google Auth)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyExampleKey12345
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tam-nhu-graduation.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tam-nhu-graduation
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# 2. Cấu hình Firebase Admin SDK (Chỉ chạy trên Server, BẢO MẬT TUYỆT ĐỐI)
FIREBASE_PROJECT_ID=tam-nhu-graduation
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tam-nhu-graduation.iam.gserviceaccount.com
# Lưu ý: Với private key nhiều dòng, thay ký tự xuống dòng bằng \n nếu đặt trên Vercel
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# 3. Email Google được phép xem admin, cách nhau bằng dấu phẩy; để trống chặn tất cả
# Ví dụ: ADMIN_EMAIL=first@gmail.com,second@gmail.com
ADMIN_EMAIL=

# 4. Link bản đồ được cấu hình trong src/lib/invitation-data.ts và src/config/event.ts

# 5. Upstash Redis (Tùy chọn: rate limiting chống spam khi deploy serverless)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
